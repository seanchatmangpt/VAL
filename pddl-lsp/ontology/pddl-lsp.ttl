pddl:ontology a owl:Ontology ;
  rdfs:label "VAL PDDL LSP manufacturing ontology" ;
  owl:imports <https://lsp-max.rs/ontology/> ;
  rdfs:comment "Source of truth for LSP 3.18 routing and LSIF 0.6 emission." .

